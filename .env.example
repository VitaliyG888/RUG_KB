# ===========================================================================
# RUG_KB — .env template.  Скопируйте в .env и заполните.
# Все значения имеют рабочие значения по умолчанию в app/config.py — можно
# не задавать всё сразу, система стартует и честно сообщит о нехватке ключей.
# ===========================================================================

# --- База данных (PostgreSQL + pgvector) ---
RUG_PG_HOST=127.0.0.1
RUG_PG_PORT=5433
RUG_PG_DB=rug_kb
RUG_PG_USER=postgres
RUG_PG_PASSWORD=postgres
RUG_PG_POOL_SIZE=5

# --- Эмбеддинги: OpenAI-совместимый endpoint ---
# Для локальных серверов (Ollama, LM Studio, vLLM, llama.cpp):
#   Ollama:   base_url=http://127.0.0.1:11434/v1
#   LM Studio:http://127.0.0.1:1234/v1
#   vLLM:     http://127.0.0.1:8000/v1
EMBED_BASE_URL=http://127.0.0.1:8000/v1
EMBED_API_KEY=none
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=16

# --- Chat LLM: OpenAI-совместимый endpoint ---
CHAT_BASE_URL=http://127.0.0.1:8000/v1
CHAT_API_KEY=none
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1400

# --- Поиск в RAG ---
RETRIEVE_TOP_K=8
# Ниже порога — считаем, что в RAG ответа нет → веб-поиск
RETRIEVE_SCORE_THRESHOLD=0.25
# Выше порога — считаем ответ уверенным, веб-дополнение не нужно
RETRIEVE_HIGH_CONFIDENCE=0.55
RETRIEVE_MIN_HITS=2
RETRIEVE_MMR=true
RETRIEVE_MMR_LAMBDA=0.7
# Вес BM25/tsvector в гибридной выдаче (0..1)
RETRIEVE_HYBRID_WEIGHT=0.3
# Кросс-язычный повторный поиск, если результатов мало
CROSS_LINGUAL_FALLBACK=true

# --- Веб-поиск (дополнение, никогда не подменяет RAG) ---
WEB_ENABLED=true
# Провайдеры по порядку попыток; ключевые адаптеры подключаются сами при наличии ключа
WEB_PROVIDERS=duckduckgo,bing
WEB_TOP_N=5
TAVILY_API_KEY=
SERPAPI_API_KEY=
SERPAPI_ENGINE=google

# --- Telegram-бот ---
BOT_TOKEN=
# числовые ID администраторов через запятую (право загрузки файлов)
BOT_ADMIN_IDS=
# Кол-во сообщений в минуту сверх лимита — игнорируются
RATE_LIMIT_PER_MINUTE=10
# Сколько последних Q/A ходов подавать в контекст
HISTORY_TURNS=6
UPLOAD_DIR=uploads

# --- Прочее ---
RUG_VERSION=0.1.0
LOG_LEVEL=INFO